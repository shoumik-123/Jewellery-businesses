{
  "name": "@jh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch-path=./src --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@jh/db": "workspace:*",
    "@jh/security": "workspace:*",
    "@jh/shared": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "dotenv": "^18.0.9",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jh/config": "workspace:*",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
