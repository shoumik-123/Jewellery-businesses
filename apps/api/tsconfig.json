{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext rather than the CommonJS the packages use: NestJS 12 ships ESM
    // only, and @jh/shared publishes subpath exports that Node10 resolution
    // cannot see. Every relative import here therefore carries a .js
    // extension, as ESM requires.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
