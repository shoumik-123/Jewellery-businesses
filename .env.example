# =============================================================================
# JewelleryHub — example environment
# Copy to .env and fill in. Documentation: docs/11-env-reference.md
# In Phase 0 this is split per app (apps/api, apps/web, apps/worker).
# Never commit a real .env. Secrets with NEXT_PUBLIC_ are exposed to browsers.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=4000
API_BASE_URL=http://localhost:4000/v1
WEB_BASE_URL=http://localhost:3000
ROOT_DOMAIN=localhost:3000
APP_SUBDOMAIN=app
ADMIN_SUBDOMAIN=admin
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# App role: NON-owner, non-superuser, so row-level security applies.
DATABASE_URL=postgresql://app_runtime:password@localhost:5432/jewelleryhub?schema=public
# Owner role: migrations and seeding only (bypasses RLS by design).
DIRECT_DATABASE_URL=postgresql://app_migrator:password@localhost:5432/jewelleryhub?schema=public
DATABASE_SSL=false
PRISMA_LOG_QUERIES=false

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=jh:
CACHE_TTL_CATALOG=300
CACHE_TTL_STORE_HOST=60

# --- Auth -------------------------------------------------------------------
# openssl genpkey -algorithm ed25519 -out jwt.pem
# openssl pkey -in jwt.pem -pubout -out jwt.pub
# then base64-encode each file
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=jh-2026-11
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- Encryption (per-store gateway credentials) -----------------------------
# openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
KMS_PROVIDER=local
KMS_KEY_ID=

# --- Storage ----------------------------------------------------------------
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=jewelleryhub
# S3 alternative
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif

# --- Email / SMS ------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=JewelleryHub
MAIL_FROM_ADDRESS=no-reply@jewelleryhub.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
SMS_PROVIDER=none
SMS_SENDER_ID=
BULKSMSBD_API_KEY=

# --- Platform payments (tenants paying US for subscriptions) ----------------
# Store-level gateway credentials are NOT set here — each store enters its own
# in the dashboard and they are stored encrypted.
PLATFORM_PAYMENT_PROVIDERS=manual
PLATFORM_SSLCOMMERZ_STORE_ID=
PLATFORM_SSLCOMMERZ_STORE_PASSWORD=
PLATFORM_SSLCOMMERZ_SANDBOX=true
PLATFORM_BKASH_APP_KEY=
PLATFORM_BKASH_APP_SECRET=
PLATFORM_BKASH_USERNAME=
PLATFORM_BKASH_PASSWORD=
PLATFORM_BKASH_SANDBOX=true
PLATFORM_NAGAD_MERCHANT_ID=
PLATFORM_NAGAD_PRIVATE_KEY=
PLATFORM_NAGAD_PUBLIC_KEY=
PLATFORM_NAGAD_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=BDT
BILLING_GRACE_DAYS=7
BILLING_DUNNING_ATTEMPTS=4
DEFAULT_TRIAL_DAYS=14

# --- Webhooks ---------------------------------------------------------------
# Locally: ngrok http 4000, then paste the https tunnel here
WEBHOOK_BASE_URL=http://localhost:4000
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_IP_ALLOWLIST=

# --- Couriers ---------------------------------------------------------------
COURIER_PROVIDERS=manual
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_SANDBOX=true
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_ACCESS_TOKEN=

# --- AI (optional; features stay hidden and inert when unset) ---------------
AI_ENABLED=false
AI_DEFAULT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jewelleryhub-api
METRICS_ENABLED=true

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_CHECKOUT_PER_MIN=10
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_DASHBOARD_PER_MIN=600
RATE_LIMIT_WEBHOOK_PER_MIN=300

# --- Queues / scheduled jobs ------------------------------------------------
QUEUE_CONCURRENCY=5
JOB_RESERVATION_SWEEP_CRON=*/1 * * * *
JOB_RENEWAL_CRON=0 * * * *
JOB_ROLLUP_INCREMENTAL_CRON=15 * * * *
JOB_ROLLUP_NIGHTLY_CRON=30 2 * * *
JOB_DOMAIN_VERIFY_CRON=*/15 * * * *
RESERVATION_TTL_MINUTES=30

# --- Frontend (apps/web) ----------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_NAME=JewelleryHub
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_IMAGE_DOMAINS=res.cloudinary.com,localhost
REVALIDATE_SECRET=

# --- Seeding ----------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@jewelleryhub.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_DEMO_DATA=true
SEED_DEMO_STORES=2
SEED_DEMO_PRODUCTS_PER_STORE=40
