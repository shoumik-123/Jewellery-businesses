{
  "name": "@jh/security",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only password and token primitives. Never imported by the web app.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2"
  },
  "devDependencies": {
    "@jh/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
