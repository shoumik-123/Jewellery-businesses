{
  "name": "@jh/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern 'src/generated/**'",
    "test": "jest",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@jh/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
